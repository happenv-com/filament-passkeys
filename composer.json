{
  "name": "happenv-com/filament-passkeys",
  "description": "Filament 5 multi-factor authentication via WebAuthn passkeys, powered by laravel/passkeys.",
  "keywords": [
    "happenv",
    "laravel",
    "filament",
    "filament-plugin",
    "mfa",
    "2fa",
    "two-factor",
    "multi-factor",
    "passkeys",
    "passkey",
    "webauthn",
    "fido2",
    "authentication",
    "filament-passkeys"
  ],
  "homepage": "https://github.com/happenv-com/filament-passkeys",
  "license": "MIT",
  "authors": [
    {
      "name": "Happenv",
      "homepage": "https://happenv.com",
      "email": "code@happenv.com",
      "role": "Maintainer"
    },
    {
        "name":"Bartłomiej Gajda",
        "role": "Contributor",
        "email": "code@webard.me"
    },
    {
      "name": "Jefferson Gonçalves",
      "email": "gerson.simao.92@gmail.com",
      "role": "Original author"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/filament": "^4.13.3|^5.3",
    "laravel/passkeys": "^0.2",
    "spatie/laravel-package-tools": "^1.14.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.21",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0|^5.0",
    "pestphp/pest-plugin-laravel": "^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "Happenv\\FilamentPasskeys\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Happenv\\FilamentPasskeys\\Tests\\": "tests"
    }
  },
  "scripts": {
    "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Happenv\\FilamentPasskeys\\FilamentPasskeysServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
